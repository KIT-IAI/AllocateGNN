      "metadata_wiring": "SpatialAllocation/GNN/core/EdgeWeightSolver.py L203-209",
      "edge_weights": "SpatialAllocation/GNN/Layer/EdgeWeightLayer.py scatter_softmax（每 source Σw=1）"
    },
    "q_pipeline_steps_verbatim": [
      "1. edge_v = aux[a_indices]; edge_v *= rci_mask[a].float()（RCI 外置零）",
      "2. edge_v = log(1 + clamp(edge_v, min=0))（log1p）",
      "3. edge_v = clamp(edge_v, min=1e-8)（floor）",
      "4. v_sum = scatter_add per source; q = edge_v/(v_sum[s]+1e-8)（按 source 归一）",
      "5. t_safe = clamp(q, 1e-8); w_safe = clamp(w, 1e-8)（KL 双侧 floor）",
      "6. valid = v_sum > 1e-6; loss = kl_per_s[valid].mean()（掩蔽 source 排除）"
    ],
